{
  "name": "@loydjs/compiler",
  "version": "1.1.0",
  "description": "Loyd compiler — JIT and AOT engine",
  "keywords": ["loyd", "validation", "typescript", "schema"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["README.md", "dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@loydjs/core": "workspace:*",
    "@loydjs/error-engine": "workspace:*",
    "@loydjs/schema": "workspace:*"
  },
  "devDependencies": {
    "@loydjs/schema": "workspace:*",
    "@vitest/ui": "^2.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "valibot": "^1.4.0",
    "vitest": "^2.1.9",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
