{
  "name": "@loydjs/async",
  "version": "0.0.0",
  "description": "Loyd async — two-pass async pipeline",
  "keywords": [
    "loyd",
    "validation",
    "typescript",
    "schema"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "echo no benchmarks",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@loydjs/core": "workspace:*",
    "@loydjs/schema": "workspace:*",
    "@loydjs/compiler": "workspace:*"
  },
  "devDependencies": {
    "@loydjs/schema": "workspace:*",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
