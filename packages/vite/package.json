{
  "name": "@loydjs/vite",
  "version": "1.0.0",
  "description": "Loyd vite - Vite/Rollup AOT plugin",
  "keywords": ["loyd", "validation", "typescript", "vite"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["README.md", "dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "echo no benchmarks",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@loydjs/compiler": "workspace:*",
    "@loydjs/core": "workspace:*",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/acorn": "^6.0.4",
    "acorn": "^8.16.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
