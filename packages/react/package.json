{
  "name": "@loydjs/react",
  "version": "1.0.0",
  "description": "Loyd react — native React hooks",
  "keywords": ["loyd", "validation", "typescript", "schema"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["README.md", "dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "echo no benchmarks",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@loydjs/core": "workspace:*",
    "@loydjs/schema": "workspace:*",
    "@loydjs/runtime": "workspace:*",
    "@loydjs/graph": "workspace:*",
    "@loydjs/async": "workspace:*",
    "@loydjs/error-engine": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@loydjs/schema": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
